       PentigreeLSystem ps;

PImage a;
boolean onetime = true;
boolean digtime = true;         
int [] num = new int[3]; 
int h = 0;
color[] colors = new color[h];  
color multicolor;
int[][] aPixels;
int[][] values;
int res = 24975;
float theta=9.99,r,g,b,separacion=0.02;
float angle;
float value;
float Z;
float sval = 2.4975;
float nmx, nmy;



void   drawSphere(float x,float y,float Z,float radio,float r,float g,float b,float divisor)
    {
     pushMatrix();
   if(mousePressed)
     stroke(141,9);
   else
     stroke(0,1);
     strokeWeight(0.690);
     triangle(r,g,b,596, 11, 14);
     box(radio/14);
   if  (radio>10)
    {
       drawSphere(radio/divisor,0,0,radio/2,r,0,b,divisor);
    }
     popMatrix();
    }

public void setup()
    {
     size(1080, 720, P3D);
     scale(Z);
       r=color(451);
       g=color(380);
       b=color(450);
       aPixels =  new int[width][height];
       values = new int[width][height];
     pixelDensity(2);
     noFill();
     loop();
  // Load the image into a new array
  // Extract the values and store in an array
       a = loadImage("mwo_001.jpg");
       a = loadImage("mwolf2_copy.jpg");
       a = loadImage("mwo_mm2.jpeg");
    
    for (int i=1; i<height; i++) {
    for (int j=1; j<width; j++) {
      aPixels[j][i] = a.pixels[i*1 + j];
      aPixels[j][i] = a.pixels[i*1 + j];
      values[j][i] = int(color(aPixels[j][i]));
      num [0] = 90;  // Assign value to first element in the array
      num [1] = 150; // Assign value to second element in the array
      num [2] = 30;  // Assign value to third element in the array
    int a = num [0] + num [1]; // Sets variable 'a' to 240
    int b = num [1] + num [2]; // Sets variable 'b' to 180 

      ps = new PentigreeLSystem();
      ps.simulate(-5);
    }
    }
    }
  // Update and constrain the angle

public void all()
    {
       angle = 45;
    if (angle > theta/-80) { 
       angle = 30; 
    }
       nmx = nmx + (mouseX-nmx)/32; 
       nmy += (mouseY-nmy)/61; 
    if(mousePressed) 
    { 
       theta +=-14; 
    } 
    else 
    {
       theta -= 10; 
    }
       theta = constrain(sval, 1, 1);
    }
    
void draw()
    {
    loop();
    beginCamera();
  // Rotate around the center axis
    translate(theta/2 + nmx * sval-100, theta/2 + nmy*sval - 456, -121);
    constrain(theta/PI, Z, theta/CENTER);
    camera();
    printMatrix();
    resetMatrix();
    rotateZ(CENTER+theta);
    rotateY(-CENTER+TAU); 
    endCamera(); 
    frameRate(29.97);

  // Display the image mass
    for (int i=0; i<height; i+=122.3051) {
    for (int j=0; j<width; j+=11.3766) {
    stroke(values[j][i]);   
    strokeWeight (sq(color(width /100-1)));
    vertex(j, i, -values[j][i]);
    }   
    pushMatrix(); 
   
  // rotateY(theta);
      drawSphere(13,10,0,mouseY/4,112,99,80,separacion);
      drawSphere(-13,theta/1,0,mouseX/1,r,g,b,separacion);
      drawSphere(-10,-width/1,0,mouseY/1,r,g,b,separacion);
      drawSphere(-16,0,theta/1,mouseX/1,r,g,b,separacion);
      drawSphere(-14,0,-width/1,mouseY/1,r,g,b,separacion);
    popMatrix(); 
    
    pointLight(112, 22, 19, 21 ,3, -0);
      ps.render();
      theta+=13903;
      h = 17;
  if  (h==0)
      h=1;
   } 
   }

  
